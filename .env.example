# Root Docker Compose / Platform Environment Template
# Copy to .env and populate strong random secrets before starting services.

NODE_ENV=production
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Required Security Secrets (minimum 32 chars / 64 hex chars — NEVER commit real values)
POSTGRES_USER=creditledger
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=credit_ledger
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_JWT_SECRET
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_AES_256_GCM_KEY

# Cors & Origin Allowlist
CORS_ORIGINS=https://app.creditledger.example

# Role Allowlists (comma-separated Stellar G... public keys)
ADMIN_PUBLIC_KEYS=
ISSUER_PUBLIC_KEYS=

# Admin Signer for Governance Operations (NEVER commit or hardcode real secret keys)
STELLAR_ADMIN_SECRET=

# Deployed Soroban Contract Addresses (Hardened v2 Stellar Testnet; Legacy v1 preserved separately)
CREDIT_SCORE_CONTRACT=CAAPEEPQJH5ZQHOYOF3KVHQNUGZV5DVPUSE4KCAKJ3E3NQGEYQ53ZUTW
LOAN_MANAGER_CONTRACT=CB4KYCG62B62RNMIGHV2NP5GDCGPGE23XW5FQVOTBE266PFPKKB5NNXB
COMMUNITY_VOUCH_CONTRACT=CAQSXBETHWHNXF5BJV37CVD2AI4D4JTVZ3J2S3YLTAPUF5V7BWFV444F
LOAN_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
COLLATERAL_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Reconciliation Worker Interval (ms)
RECONCILER_INTERVAL_MS=60000
VITE_API_URL=/api
