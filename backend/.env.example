# CreditLedger Backend Environment Template
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=credit_ledger
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis (Required in production for atomic nonce replay protection & JTI revocation)
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@localhost:6379

# Authentication & At-Rest Encryption (REQUIRED >= 32 chars / 64 hex chars in production)
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_SECRET
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_AES_256_GCM_KEY

# Strict CORS Allowlist
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Stellar / Soroban Network & Contracts
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
CREDIT_SCORE_CONTRACT=CAAPEEPQJH5ZQHOYOF3KVHQNUGZV5DVPUSE4KCAKJ3E3NQGEYQ53ZUTW
LOAN_MANAGER_CONTRACT=CB4KYCG62B62RNMIGHV2NP5GDCGPGE23XW5FQVOTBE266PFPKKB5NNXB
COMMUNITY_VOUCH_CONTRACT=CAQSXBETHWHNXF5BJV37CVD2AI4D4JTVZ3J2S3YLTAPUF5V7BWFV444F
LOAN_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
COLLATERAL_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Governance Roles (comma-separated Stellar G... public keys)
ADMIN_PUBLIC_KEYS=
ISSUER_PUBLIC_KEYS=

# Optional Admin Signing Key (only for dedicated backend governance signer / local dev; keep empty in CI)
STELLAR_ADMIN_SECRET=

# Background Transaction Reconciliation
RECONCILER_INTERVAL_MS=60000
LOG_LEVEL=info
